---
// src/pages/egitimler.astro
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="tr">
<head>
    <!-- SEO İÇİN BASEHEAD BİLEŞENİ EKLENDİ -->
    <BaseHead 
        title="Dinamik Eğitimler | DataPlaybook" 
        description="SQL, SAP ve veri analizi üzerine kurulum gerektirmeyen, tarayıcı tabanlı interaktif ve uygulamalı eğitim laboratuvarları." 
    />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <!-- ÜST PANEL -->
    <Header />

    <!-- EĞİTİM MERKEZİ BAŞLIĞI -->
    <header class="page-header">
        <div class="container">
            <div class="status-badge">
                <span class="pulse-dot"></span> SİSTEM AKTİF — ÇALIŞMA ORTAMI HAZIR
            </div>
            <h1>Dinamik Eğitimler</h1>
            <p>
                Teoriyi uygulamayla pekiştirin. Gerçek iş senaryolarını temel alan eğitimlerimizde, kurulum gerektirmeyen sanal laboratuvar ortamında SQL sorgularını yazabilir, SAP ekranlarını birebir deneyimleyebilir ve öğrendiklerinizi anında uygulayabilirsiniz.
            </p>
        </div>
    </header>

    <!-- KURS MODÜLLERİ -->
    <section class="courses-section">
        <div class="container">
            <div class="courses-grid">
                
                <!-- SQL Kursu -->
                <div class="course-card card-sql">
                    <div class="course-icon sql-theme">
                        <i class="fa-solid fa-database"></i>
                    </div>
                    <div class="course-content">
                        <div class="card-top-tag">v3.1 / DWH_ENGINE</div>
                        <!-- SEO: H3'ler H2 olarak güncellendi -->
                        <h2>İnteraktif SQL Eğitimi</h2>
                        <p>Tarayıcı üzerinden gerçek veri setleriyle kod yazarak SQL öğrenin. Sorguları çalıştırın, sonuçları anında görün.</p>
                        <div class="course-meta">
                            <span><i class="fa-solid fa-layer-group"></i> 12 Modül</span>
                            <span><i class="fa-solid fa-signal"></i> Başlangıç - İleri</span>
                        </div>
                        <a href="/sql-ogren" class="btn btn-start sql-btn">Eğitime Başla <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>

                <!-- SAP Kursu (T-Code / ERP Simülasyonu) -->
                <div class="course-card card-sap">
                    <div class="course-icon sap-theme">
                        <i class="fa-solid fa-cube"></i>
                    </div>
                    <div class="course-content">
                        <div class="card-top-tag">v2.0 / ERP_SIM</div>
                        <h2>SAP Modül Pratikleri</h2>
                        <p>SD, MM ve FI modüllerindeki temel veri akışlarını simüle edin ve tablolar arası ilişkileri kavrayın.</p>
                        <div class="course-meta">
                            <span><i class="fa-solid fa-layer-group"></i> 8 Modül</span>
                            <span><i class="fa-solid fa-signal"></i> Orta Seviye</span>
                        </div>
                        <a href="/sap-ogren" class="btn btn-start sap-btn">Simülasyonlara Git <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>

                <!-- SAP ABAP Kursu (Programlama / SE38 Editör Simülasyonu) -->
                <div class="course-card card-abap">
                    <div class="course-icon abap-theme">
                        <i class="fa-solid fa-terminal"></i>
                    </div>
                    <div class="course-content">
                        <div class="card-top-tag">v1.4 / ABAP_RUNTIME</div>
                        <h2>SAP ABAP Eğitim Simülatörü</h2>
                        <p>Gerçek SE38 / ABAP editör deneyimiyle kod yazın. DATA, IF, LOOP AT ve SELECT gibi temel ifadeleri F8 ile çalıştırıp çıktısını anında görün.</p>
                        <div class="course-meta">
                            <span><i class="fa-solid fa-layer-group"></i> 9 Ders</span>
                            <span><i class="fa-solid fa-signal"></i> Başlangıç - Orta</span>
                        </div>
                        <a href="/sap-abap-ogren" class="btn btn-start abap-btn">Editörü Aç <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>

                <!-- İş Zekası / BI Kursu (YAKINDA) -->
                <div class="course-card disabled-card card-bi">
                    <div class="course-icon bi-theme">
                        <i class="fa-solid fa-chart-pie"></i>
                    </div>
                    <div class="course-content">
                        <div class="card-top-tag">YAKINDA / QLIK & POWERBI</div>
                        <h2>Dinamik Dashboard Tasarımı</h2>
                        <p>Qlik Sense ve PowerBI mantığıyla veri modelleme ve görselleştirme senaryoları üzerinde çalışın.</p>
                        <div class="course-meta">
                            <span><i class="fa-solid fa-layer-group"></i> 5 Proje</span>
                            <span><i class="fa-solid fa-signal"></i> Orta Seviye</span>
                        </div>
                        <div class="btn btn-start btn-disabled"><i class="fa-solid fa-clock"></i> Çok Yakında</div>
                    </div>
                </div>

                <!-- ETL Kursu (YAKINDA) -->
                <div class="course-card disabled-card card-etl">
                    <div class="course-icon etl-theme">
                        <i class="fa-solid fa-network-wired"></i>
                    </div>
                    <div class="course-content">
                        <div class="card-top-tag">YAKINDA / PIPELINE</div>
                        <h2>ETL Veri Boru Hatları</h2>
                        <p>Farklı kaynaklardan veriyi çekip, temizleyip, dönüştürerek hedef sisteme aktarma (Data Pipeline) egzersizleri.</p>
                        <div class="course-meta">
                            <span><i class="fa-solid fa-layer-group"></i> 6 Senaryo</span>
                            <span><i class="fa-solid fa-signal"></i> İleri Seviye</span>
                        </div>
                        <div class="btn btn-start btn-disabled"><i class="fa-solid fa-clock"></i> Çok Yakında</div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ALT PANEL -->
    <Footer />

</body>
</html>

<style>
    :root {
        --bg-dark: #0a0e17; 
        --bg-darker: #02060f;
        --text-main: #f0f6fc;
        --text-muted: #8b949e;
        --border-color: #30363d;
        
        --sql-color: #f59e0b;
        --sap-color: #3b82f6;
        --abap-color: #f43f5e;
        --bi-color: #10b981;
        --etl-color: #a855f7;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--bg-dark);
        background-image: 
            linear-gradient(rgba(148, 163, 184, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(148, 163, 184, 0.03) 1px, transparent 1px);
        background-size: 40px 40px;
        color: var(--text-main);
        line-height: 1.6;
        overflow-x: hidden;
    }

    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* HEADER & STATUS BADGE */
    .page-header {
        padding: 60px 0 40px;
        text-align: center;
        background: linear-gradient(180deg, rgba(2,6,15,0.8) 0%, var(--bg-dark) 100%);
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        color: var(--bi-color);
        font-family: monospace;
        font-size: 0.75rem;
        padding: 6px 14px;
        border-radius: 20px;
        margin-bottom: 1.2rem;
        letter-spacing: 0.05em;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: var(--bi-color);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--bi-color);
        animation: pulseAnimation 2s infinite;
    }

    @keyframes pulseAnimation {
        0% { transform: scale(0.95); opacity: 0.8; box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); opacity: 1; box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); opacity: 0.8; box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }

    .page-header h1 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 700;
        margin-bottom: 15px;
        letter-spacing: -0.02em;
    }

    .page-header p {
        color: var(--text-muted);
        font-size: 1.05rem;
        max-width: 750px;
        margin: 0 auto;
        line-height: 1.7;
    }

    /* KURS KARTLARI */
    .courses-section {
        padding: 30px 0 80px;
    }

    .courses-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(480px, 1fr));
        gap: 2rem;
    }

    .course-card {
        background-color: #0d1117;
        border: 1px solid var(--border-color);
        border-radius: 14px;
        display: flex;
        padding: 1.8rem;
        gap: 1.5rem;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s;
    }

    .course-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: transparent;
        transition: background 0.3s;
    }

    .course-card.card-sql:hover::before  { background: var(--sql-color); }
    .course-card.card-sap:hover::before  { background: var(--sap-color); }
    .course-card.card-abap:hover::before { background: var(--abap-color); }

    .course-card:not(.disabled-card):hover {
        transform: translateY(-6px);
        border-color: rgba(148, 163, 184, 0.3);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    }

    .disabled-card {
        opacity: 0.8;
        background: linear-gradient(145deg, #0d1117 0%, #080c10 100%);
    }

    .card-top-tag {
        font-family: monospace;
        font-size: 0.7rem;
        color: var(--text-muted);
        margin-bottom: 0.6rem;
        letter-spacing: 0.08em;
    }

    .course-icon {
        width: 68px;
        height: 68px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        flex-shrink: 0;
        transition: transform 0.3s ease;
    }

    .course-card:hover .course-icon {
        transform: scale(1.08) rotate(3deg);
    }

    .sql-theme  { background-color: rgba(245, 158, 11, 0.1); color: var(--sql-color); border: 1px solid rgba(245, 158, 11, 0.2); }
    .sap-theme  { background-color: rgba(59, 130, 246, 0.1); color: var(--sap-color); border: 1px solid rgba(59, 130, 246, 0.2); }
    .abap-theme { background-color: rgba(244, 63, 94, 0.1); color: var(--abap-color); border: 1px solid rgba(244, 63, 94, 0.2); }
    .bi-theme   { background-color: rgba(16, 185, 129, 0.1); color: var(--bi-color); border: 1px solid rgba(16, 185, 129, 0.2); }
    .etl-theme  { background-color: rgba(168, 85, 247, 0.1); color: var(--etl-color); border: 1px solid rgba(168, 85, 247, 0.2); }

    .disabled-card .bi-theme { background-color: rgba(16, 185, 129, 0.04); color: rgba(16, 185, 129, 0.4); border-color: transparent; }
    .disabled-card .etl-theme { background-color: rgba(168, 85, 247, 0.04); color: rgba(168, 85, 247, 0.4); border-color: transparent; }

    .course-content {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    /* SEO: CSS KURALI H3 YERİNE H2 OLARAK GÜNCELLENDİ */
    .course-content h2 {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
        font-weight: 600;
    }

    .course-content p {
        color: var(--text-muted);
        font-size: 0.9rem;
        margin-bottom: 1.2rem;
        line-height: 1.5;
    }

    .course-meta {
        display: flex;
        gap: 0.8rem;
        margin-bottom: 1.4rem;
        flex-wrap: wrap;
    }

    .course-meta span {
        font-size: 0.78rem;
        color: #9ca3af;
        background-color: #161b22;
        border: 1px solid #21262d;
        padding: 4px 10px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-start {
        margin-top: auto;
        padding: 10px 16px;
        text-align: center;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

    .sql-btn { background-color: rgba(245, 158, 11, 0.12); color: var(--sql-color); border: 1px solid rgba(245, 158, 11, 0.3); }
    .sql-btn:hover { background-color: var(--sql-color); color: #000; box-shadow: 0 0 15px rgba(245, 158, 11, 0.4); }

    .sap-btn { background-color: rgba(59, 130, 246, 0.12); color: var(--sap-color); border: 1px solid rgba(59, 130, 246, 0.3); }
    .sap-btn:hover { background-color: var(--sap-color); color: #fff; box-shadow: 0 0 15px rgba(59, 130, 246, 0.4); }

    .abap-btn { background-color: rgba(244, 63, 94, 0.12); color: var(--abap-color); border: 1px solid rgba(244, 63, 94, 0.3); }
    .abap-btn:hover { background-color: var(--abap-color); color: #fff; box-shadow: 0 0 15px rgba(244, 63, 94, 0.4); }

    .btn-disabled { 
        background-color: #161b22; 
        color: #6b7280; 
        border: 1px dashed #30363d;
        cursor: not-allowed;
    }

    @media (max-width: 768px) {
        .courses-grid { grid-template-columns: 1fr; }
        .course-card { flex-direction: column; padding: 1.4rem; }
        .course-icon { width: 56px; height: 56px; font-size: 1.4rem; }
    }
</style>