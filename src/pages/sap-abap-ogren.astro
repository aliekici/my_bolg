/* =========================================================
   Mini ABAP yorumlayıcı (eğitim amaçlı, gerçek derleyici değildir)
   ========================================================= */
function stripComments(source){
  return source.split('\n').map(line=>{
    if(/^\s*\*/.test(line)) return '';
    const idx = line.indexOf('"');
    if(idx !== -1) return line.slice(0, idx);
    return line;
  }).join('\n');
}
function splitStatements(source){
  const statements = []; let current=''; let inString=false;
  for(let i=0;i<source.length;i++){
    const ch = source[i];
    if(ch === "'"){ inString = !inString; current+=ch; continue; }
    if(ch === '.' && !inString){
      const prev = source[i-1], next = source[i+1];
      const isDecimal = /[0-9]/.test(prev||'') && /[0-9]/.test(next||'');
      if(isDecimal){ current+=ch; continue; }
      const t = current.trim();
      if(t.length) statements.push(t);
      current='';
      continue;
    }
    current += ch;
  }
  if(current.trim().length) statements.push(current.trim());
  return statements;
}
function splitTopLevel(str, sep){
  const parts=[]; let current=''; let inString=false;
  for(let i=0;i<str.length;i++){
    const ch = str[i];
    if(ch === "'"){ inString = !inString; current+=ch; continue; }
    if(ch === sep && !inString){ parts.push(current.trim()); current=''; continue; }
    current += ch;
  }
  if(current.trim().length) parts.push(current.trim());
  return parts;
}
function getField(obj, name){
  if(!obj) return undefined;
  const key = Object.keys(obj).find(k => k.toLowerCase() === name.toLowerCase());
  return key ? obj[key] : undefined;
}

/* ---- deger cozumleme (degisken / literal / sy-index / wa-alan) ---- */
function resolveValue(token, vars){
  token = (token||'').trim();
  const strMatch = token.match(/^'([^']*)'$/);
  if(strMatch) return strMatch[1];
  if(/^-?\d+(\.\d+)?$/.test(token)) return token;
  if(/^sy-index$/i.test(token)) return vars['__sy_index__']!==undefined ? String(vars['__sy_index__']) : '0';
  if(/^sy-tabix$/i.test(token)) return vars['__sy_tabix__']!==undefined ? String(vars['__sy_tabix__']) : '0';
  if(token.includes('-')){
    const [waName, field] = token.split('-');
    const wa = vars[waName.trim()];
    const val = getField(wa, (field||'').trim());
    return val;
  }
  if(Object.prototype.hasOwnProperty.call(vars, token)) return vars[token];
  return undefined;
}
function resolveWriteItem(item, vars){
  item = item.trim().replace(/^\//,'').trim();
  if(!item) return null;
  const strMatch = item.match(/^'([^']*)'$/);
  if(strMatch) return strMatch[1];
  if(/^sy-index$/i.test(item)) return vars['__sy_index__']!==undefined ? String(vars['__sy_index__']) : '0';
  if(/^sy-tabix$/i.test(item)) return vars['__sy_tabix__']!==undefined ? String(vars['__sy_tabix__']) : '0';
  if(item.includes('-')){
    const [waName, field] = item.split('-');
    const wa = vars[waName.trim()];
    const val = getField(wa, field.trim());
    return val !== undefined ? String(val) : `<${item}>`;
  }
  if(Object.prototype.hasOwnProperty.call(vars, item)) return String(vars[item]);
  return `<${item}>`;
}

/* ---- basit aritmetik ifade (yalnizca bosluklarla ayrilan + / - operatorlerini boler,
        boylece 'wa-alan' gibi tire iceren alan referanslarini bozmaz) ---- */
function evalExpression(expr, vars){
  expr = (expr||'').trim();
  const parts = expr.split(/\s+(\+|-)\s+/).filter(x=>x!=='');
  let result = resolveValue(parts[0], vars);
  result = (result!==undefined && !isNaN(parseFloat(result)) && /^-?\d+(\.\d+)?$/.test(String(result).trim())) ? parseFloat(result) : result;
  for(let i=1;i<parts.length;i+=2){
    const op = parts[i];
    const rawVal = resolveValue(parts[i+1], vars);
    const num = parseFloat(rawVal);
    const base = parseFloat(result);
    if(op==='+') result = (isNaN(base)?0:base) + (isNaN(num)?0:num);
    else result = (isNaN(base)?0:base) - (isNaN(num)?0:num);
  }
  return result;
}

/* ---- kosul degerlendirme (=, <>, >, <, >=, <=, EQ/NE/GT/LT/GE/LE, IS INITIAL) ---- */
function evalCondition(cond, vars){
  cond = (cond||'').trim();
  let m = cond.match(/^(.+?)\s+IS\s+(NOT\s+)?INITIAL$/i);
  if(m){
    const val = resolveValue(m[1].trim(), vars);
    const isEmpty = (val===undefined || val===null || val==='' || val==='0');
    return m[2] ? !isEmpty : isEmpty;
  }
  const opMap = {'EQ':'==','NE':'!=','GT':'>','LT':'<','GE':'>=','LE':'<='};
  let left, opSym, right;
  const symMatch = cond.match(/^(.+?)\s*(>=|<=|<>|=|>|<)\s*(.+)$/);
  if(symMatch){ left=symMatch[1].trim(); opSym=symMatch[2]; right=symMatch[3].trim(); }
  else{
    const wordMatch = cond.match(/^(.+?)\s+(EQ|NE|GT|LT|GE|LE)\s+(.+)$/i);
    if(wordMatch){ left=wordMatch[1].trim(); opSym=opMap[wordMatch[2].toUpperCase()]; right=wordMatch[3].trim(); }
  }
  if(!opSym) return false;
  if(opSym==='=') opSym='==';
  if(opSym==='<>') opSym='!=';
  const lv = resolveValue(left, vars);
  const rv = resolveValue(right, vars);
  const lNumeric = lv!==undefined && /^-?\d+(\.\d+)?$/.test(String(lv).trim());
  const rNumeric = rv!==undefined && /^-?\d+(\.\d+)?$/.test(String(rv).trim());
  let a, b;
  if(lNumeric && rNumeric){ a=parseFloat(lv); b=parseFloat(rv); }
  else{ a = lv===undefined?'':String(lv); b = rv===undefined?'':String(rv); }
  switch(opSym){
    case '==': return a==b;
    case '!=': return a!=b;
    case '>':  return a>b;
    case '<':  return a<b;
    case '>=': return a>=b;
    case '<=': return a<=b;
  }
  return false;
}

/* ---- tekil (blok icermeyen) ifadeler ---- */
function processStatement(stmt, vars, output){
  if(/^REPORT\b/i.test(stmt)) return;
  if(/^TYPES:?/i.test(stmt)) return;
  if(/^DATA:?/i.test(stmt)){
    const declPart = stmt.replace(/^DATA:?/i,'').trim();
    const decls = splitTopLevel(declPart, ',');
    decls.forEach(d=>{
      d = d.trim();
      if(!d) return;
      let mm = d.match(/^(\w+)\s+TYPE\s+[\w\-\(\)]+\s+VALUE\s+'([^']*)'/i);
      if(mm){ vars[mm[1]] = mm[2]; return; }
      mm = d.match(/^(\w+)\s+TYPE\s+[\w\-\(\)]+\s+VALUE\s+(-?\d+(\.\d+)?)/i);
      if(mm){ vars[mm[1]] = mm[2]; return; }
      mm = d.match(/^(\w+)\s+TYPE\s+(?:STANDARD\s+TABLE\s+OF|TABLE\s+OF)\s+/i);
      if(mm){ vars[mm[1]] = vars[mm[1]] || []; return; }
      mm = d.match(/^(\w+)\s+TYPE\s+/i);
      if(mm){ if(!(mm[1] in vars)) vars[mm[1]] = ''; return; }
    });
    return;
  }
  if(/^SELECT\b/i.test(stmt)){
    const m = stmt.match(/^SELECT\s+(.+?)\s+FROM\s+(\w+)\s+INTO\s+TABLE\s+(?:@DATA\()?(\w+)\)?(?:\s+UP TO\s+(\d+)\s+ROWS)?/i);
    if(!m){ output.push('[HATA] SELECT ifadesi cozumlenemedi: ' + stmt); return; }
    const fields = m[1].trim();
    const table = m[2].toLowerCase();
    const itabName = m[3];
    const upTo = m[4] ? parseInt(m[4],10) : null;
    const rows = MOCK_TABLES[table];
    if(!rows){ output.push(`[HATA] '${table}' tablosu demo veritabaninda tanimli degil.`); vars[itabName]=[]; return; }
    let sliced = upTo ? rows.slice(0, upTo) : rows.slice();
    if(fields !== '*'){
      const fieldList = fields.split(/\s+/).map(f=>f.toLowerCase());
      sliced = sliced.map(r=>{
        const o={};
        fieldList.forEach(f=>{ const k=Object.keys(r).find(kk=>kk.toLowerCase()===f); if(k) o[k]=r[k]; });
        return o;
      });
    } else {
      sliced = sliced.map(r=>({...r}));
    }
    vars[itabName] = sliced;
    return;
  }
  if(/^WRITE:?/i.test(stmt)){
    const rest = stmt.replace(/^WRITE:?/i,'').trim();
    const items = splitTopLevel(rest, ',');
    const parts = items.map(it=>resolveWriteItem(it, vars)).filter(x=>x!==null);
    output.push(parts.join('   '));
    return;
  }
  if(/^ADD\b/i.test(stmt)){
    const m = stmt.match(/^ADD\s+(.+?)\s+TO\s+(\w+)$/i);
    if(m){
      const val = evalExpression(m[1], vars);
      const cur = parseFloat(vars[m[2]]); const add = parseFloat(val);
      vars[m[2]] = (isNaN(cur)?0:cur) + (isNaN(add)?0:add);
    }
    return;
  }
  if(/^SUBTRACT\b/i.test(stmt)){
    const m = stmt.match(/^SUBTRACT\s+(.+?)\s+FROM\s+(\w+)$/i);
    if(m){
      const val = evalExpression(m[1], vars);
      const cur = parseFloat(vars[m[2]]); const sub = parseFloat(val);
      vars[m[2]] = (isNaN(cur)?0:cur) - (isNaN(sub)?0:sub);
    }
    return;
  }
  if(/^CLEAR\b/i.test(stmt)){
    const m = stmt.match(/^CLEAR\s+(\w+)$/i);
    if(m){ vars[m[1]] = Array.isArray(vars[m[1]]) ? [] : ''; }
    return;
  }
  if(/^CONCATENATE\b/i.test(stmt)){
    const m = stmt.match(/^CONCATENATE\s+(.+?)\s+INTO\s+(\w+)(?:\s+SEPARATED BY\s+'([^']*)')?$/i);
    if(m){
      const tokens = m[1].trim().split(/\s+/);
      const parts = tokens.map(t=>{ const v = resolveValue(t, vars); return v===undefined?'':String(v); });
      const sep = m[3]!==undefined ? m[3] : '';
      vars[m[2]] = parts.join(sep);
    }
    return;
  }
  if(/^APPEND\b/i.test(stmt)){
    const m = stmt.match(/^APPEND\s+(\w+)\s+TO\s+(\w+)$/i);
    if(m){
      if(!Array.isArray(vars[m[2]])) vars[m[2]] = [];
      const src = vars[m[1]];
      vars[m[2]].push(typeof src==='object' && src!==null ? {...src} : src);
    }
    return;
  }
  const mAssign = stmt.match(/^([\w-]+)\s*=\s*(.+)$/);
  if(mAssign){
    const left = mAssign[1];
    const val = evalExpression(mAssign[2], vars);
    if(left.includes('-')){
      const [waName, field] = left.split('-');
      if(typeof vars[waName] !== 'object' || vars[waName]===null || Array.isArray(vars[waName])) vars[waName] = {};
      vars[waName][field] = val;
    } else {
      vars[left] = val;
    }
    return;
  }
}

/* ---- blok yapisini agaca donusturen ayristirici (IF/DO/WHILE/LOOP) ---- */
function parseBlock(stmts, idx, enderRegex){
  const nodes = [];
  while(idx < stmts.length){
    const s = stmts[idx].trim();
    if(enderRegex.test(s)) return {nodes, idx};

    if(/^IF\b/i.test(s)){
      const branches = [];
      let cond = s.replace(/^IF\s+/i,'');
      let r = parseBlock(stmts, idx+1, /^(ELSEIF|ELSE|ENDIF)\b/i);
      branches.push({cond, body:r.nodes});
      idx = r.idx;
      while(idx < stmts.length && /^ELSEIF\b/i.test(stmts[idx].trim())){
        const c2 = stmts[idx].trim().replace(/^ELSEIF\s+/i,'');
        const r2 = parseBlock(stmts, idx+1, /^(ELSEIF|ELSE|ENDIF)\b/i);
        branches.push({cond:c2, body:r2.nodes});
        idx = r2.idx;
      }
      let elseBody = [];
      if(idx < stmts.length && /^ELSE$/i.test(stmts[idx].trim())){
        const r3 = parseBlock(stmts, idx+1, /^ENDIF\b/i);
        elseBody = r3.nodes;
        idx = r3.idx;
      }
      idx = idx+1; // ENDIF'i atla
      nodes.push({type:'if', branches, elseBody});
      continue;
    }

    if(/^DO\b/i.test(s)){
      const m = s.match(/^DO\s+(\d+)\s+TIMES$/i);
      const times = m ? parseInt(m[1],10) : 0;
      const r = parseBlock(stmts, idx+1, /^ENDDO$/i);
      idx = r.idx+1;
      nodes.push({type:'do', times, body:r.nodes});
      continue;
    }

    if(/^WHILE\b/i.test(s)){
      const cond = s.replace(/^WHILE\s+/i,'');
      const r = parseBlock(stmts, idx+1, /^ENDWHILE$/i);
      idx = r.idx+1;
      nodes.push({type:'while', cond, body:r.nodes});
      continue;
    }

    if(/^LOOP\s+AT\b/i.test(s)){
      const m = s.match(/^LOOP\s+AT\s+(\w+)\s+INTO\s+(\w+)/i);
      const r = parseBlock(stmts, idx+1, /^ENDLOOP$/i);
      idx = r.idx+1;
      nodes.push({type:'loop', itab: m?m[1]:null, wa: m?m[2]:null, body:r.nodes});
      continue;
    }

    nodes.push({type:'simple', text:s});
    idx++;
  }
  return {nodes, idx};
}

/* ---- agac yorumlayici ---- */
function runNodes(nodes, vars, output){
  for(const node of nodes){
    if(node.type==='simple'){
      processStatement(node.text, vars, output);
    } else if(node.type==='if'){
      let executed = false;
      for(const br of node.branches){
        if(evalCondition(br.cond, vars)){ runNodes(br.body, vars, output); executed=true; break; }
      }
      if(!executed) runNodes(node.elseBody, vars, output);
    } else if(node.type==='do'){
      for(let i=1;i<=node.times;i++){ vars['__sy_index__']=i; runNodes(node.body, vars, output); }
    } else if(node.type==='while'){
      let guard = 0;
      while(evalCondition(node.cond, vars) && guard < 1000){ runNodes(node.body, vars, output); guard++; }
      if(guard>=1000) output.push('[HATA] WHILE dongusu 1000 tekrari astigi icin durduruldu.');
    } else if(node.type==='loop'){
      const rows = node.itab ? (vars[node.itab] || []) : [];
      let tabix = 0;
      for(const row of rows){
        tabix++;
        if(node.wa) vars[node.wa] = row;
        vars['__sy_tabix__'] = tabix;
        runNodes(node.body, vars, output);
      }
    }
  }
}

function executeAbap(sourceCode){
  const cleaned = stripComments(sourceCode);
  const stmts = splitStatements(cleaned);
  const vars = {}; const output = [];
  try{
    const tree = parseBlock(stmts, 0, /^\u0000NEVER\u0000$/).nodes;
    runNodes(tree, vars, output);
  }catch(e){
    output.push('[HATA] Yorumlayici bir sorunla karsilasti: ' + e.message);
  }
  return output;
}

/* ---------- Sozdizimi renklendirme ---------- */
const KEYWORDS = ['REPORT','DATA','TYPES','BEGIN','OF','END','SELECT','FROM','INTO','TABLE','STANDARD','UP','TO','ROWS',
  'WRITE','LOOP','AT','ENDLOOP','VALUE','TYPE','IF','ELSEIF','ELSE','ENDIF','DO','TIMES','ENDDO','WHILE','ENDWHILE',
  'ADD','SUBTRACT','CLEAR','CONCATENATE','SEPARATED','BY','APPEND','FROM','IS','NOT','INITIAL','EQ','NE','GT','LT','GE','LE'];
const KW_REGEX = new RegExp('\\b(' + KEYWORDS.join('|') + ')\\b', 'gi');
function escapeHtml(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function highlight(code){
  let e = escapeHtml(code);
  e = e.replace(/^(\s*)(\*.*)$/gm, '$1<span class="cmt">$2</span>');
  e = e.replace(/"(.*)$/gm, '<span class="cmt">"$1</span>');
  e = e.replace(/'([^']*)'/g, "<span class=\"str\">'$1'</span>");
  e = e.replace(KW_REGEX, '<span class="kw">$1</span>');
  return e;
}
function updateGutter(code){
  const lines = code.split('\n').length;
  let out = '';
  for(let i=1;i<=lines;i++) out += i + '\n';
  document.getElementById('gutter').textContent = out.trim() ? out : '1';
}

