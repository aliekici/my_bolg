{
  title:"ABAP'a Giriş ve İlk Programınız",
  program:"ZTEST_DERS1",
  objectives:[
    "Bir ABAP programının temel iskeletini (REPORT ifadesi) tanımak",
    "DATA ile değişken tanımlamayı öğrenmek",
