    const li = document.createElement('li');
    li.className = 'lesson-item' + (i===currentLesson ? ' active' : '') + (completedLessons.has(i) ? ' done' : '');
    li.innerHTML = `<span class="lesson-num">${completedLessons.has(i) && i!==currentLesson ? '✓' : i+1}</span>
      <span class="lesson-txt"><span class="lt">Ders ${i+1}</span>${l.title}</span>`;
    li.addEventListener('click', ()=> loadLesson(i, true));
    list.appendChild(li);
  });
  document.getElementById('sidebarProgress').textContent = `Ders ${currentLesson+1} / ${LESSONS.length}`;
}

function renderLessonPanel(){
  const l = LESSONS[currentLesson];
  document.getElementById('lpEyebrow').textContent = 'Ders ' + (currentLesson+1) + ' / ' + LESSONS.length;
  document.getElementById('lpTitle').textContent = l.title;
  document.getElementById('lpObjectives').innerHTML = l.objectives.map(o=>`<li>${o}</li>`).join('');
  document.getElementById('lpText').innerHTML = l.text.map(p=>`<p>${p}</p>`).join('');
  document.getElementById('lpSyntax').innerHTML = (l.syntax||[]).map(s=>
    `<div class="syntax-box"><span class="sx-title">Sözdizimi</span>${escapeHtml(s)}</div>`
  ).join('');
  document.getElementById('lpProgress').textContent = `Ders ${currentLesson+1} / ${LESSONS.length}`;
  document.getElementById('titlebarText').textContent = 'SAP — ABAP Editör: Include ' + l.program;
  document.getElementById('okcode').value = '';
  document.getElementById('btnPrev').disabled = currentLesson===0;
  document.getElementById('btnNext').textContent = currentLesson===LESSONS.length-1 ? 'Dersi Tamamla ✓' : 'Sonraki Ders →';
}

function loadLesson(i, forceCodeReload){
  currentLesson = Math.max(0, Math.min(LESSONS.length-1, i));
  renderSidebar();
  renderLessonPanel();
  if(forceCodeReload){
    codeInput.value = LESSONS[currentLesson].code;
    refreshEditor();
    screenOutput.classList.remove('show');
    screenEditor.classList.add('show');
  }
}

document.getElementById('btnPrev').addEventListener('click', ()=>{
  if(currentLesson>0) loadLesson(currentLesson-1, true);
});
document.getElementById('btnNext').addEventListener('click', ()=>{
  completedLessons.add(currentLesson);
  if(currentLesson < LESSONS.length-1) loadLesson(currentLesson+1, true);
  else { renderSidebar(); }
});

/* =========================================================
   ANA SAYFA (ders listesi) <-> DERS GÖRÜNÜMÜ geçişleri
   ========================================================= */
const courseHome = document.getElementById('courseHome');
const lessonView = document.getElementById('lessonView');

function goToLessonView(i){
  courseHome.style.display = 'none';
  lessonView.style.display = 'block';
  loadLesson(i, true);
  window.scrollTo({top:0, behavior:'smooth'});
}
function goToHome(){
  lessonView.style.display = 'none';
  courseHome.style.display = 'block';
  renderHome();
  window.scrollTo({top:0, behavior:'smooth'});
}

function renderHome(){
  const rows = document.getElementById('lessonRows');
  rows.innerHTML = '';
  LESSONS.forEach((l,i)=>{
    const done = completedLessons.has(i);
    const row = document.createElement('div');
    row.className = 'lesson-row' + (done ? ' done' : '');
    row.innerHTML = `
      <span class="lr-num">${done ? '✓' : i+1}</span>
      <span class="lr-title">${l.title}</span>
      <button class="start-btn">${done ? 'Tekrarla' : (completedLessons.size>0 ? 'Devam Et' : 'Başla')}</button>
    `;
    row.querySelector('.start-btn').addEventListener('click', ()=> goToLessonView(i));
    rows.appendChild(row);
  });

  const total = LESSONS.length;
  const done = completedLessons.size;
  const pct = Math.round((done/total)*100);
  const xp = done * 25;
  const level = Math.floor(xp/100) + 1;

  document.getElementById('statLessons').textContent = `${done} / ${total}`;
  document.getElementById('statXP').textContent = `${xp} / ${total*25}`;
  document.getElementById('homeProgressFill').style.width = pct + '%';
  document.getElementById('avatarLevel').textContent = 'SEVİYE ' + level;
  document.getElementById('avatarBadge').textContent = done===total ? '🏅' : ':)';
}

document.getElementById('btnHeaderBack').addEventListener('click', ()=>{
  if(lessonView.style.display === 'block'){
    goToHome();
  } else {
    if(document.referrer){ window.history.back(); }
  }
});

renderHome();
</script>

<script>
/* =========================================================
   GELİŞTİRME EKİ — XP / İlerleme Kalıcılığı (localStorage)
   Bu blok, yukarıdaki SAP ABAP editörü/yorumlayıcı koduna
   HİÇBİR ŞEKİLDE dokunmaz; onu saran, tamamen ek bir katmandır.
   Amaç: ders ilerlemesini ve basit bir XP/seviye sistemini
   tarayıcıda kalıcı hale getirmek.
   ========================================================= */
(function(){
  const STORAGE_KEY = 'abap_egitim_ilerleme_v1';
  const XP_PER_LESSON = 25;

  function readSaved(){
    try{
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : null;
    }catch(e){ return null; }
  }
  function persist(){
    try{
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        completed: Array.from(completedLessons),
        current: currentLesson
      }));
    }catch(e){ /* localStorage yoksa (gizli sekme vb.) sessizce yok say */ }
  }

  function updateGamificationUI(){
    const total = LESSONS.length;
    const done = completedLessons.size;
    const pct = Math.round((done/total)*100);
    const xp = done * XP_PER_LESSON;
    const level = Math.floor(xp/100) + 1;

    const sidebarPercent = document.getElementById('sidebarPercent');
    const sidebarBar     = document.getElementById('sidebarBar');
    if(sidebarPercent) sidebarPercent.textContent = pct + '%';
    if(sidebarBar)     sidebarBar.style.width = pct + '%';

    // Ana sayfa istatistikleri de güncel tutulur (görünür olsun ya da olmasın).
    renderHome();
  }

  // renderSidebar'ı sarmalayarak, orijinal render'dan sonra ilerleme
  // çubuklarını da güncelliyoruz. Orijinal fonksiyonun içeriği aynen kalır.
  const _renderSidebar = renderSidebar;
  renderSidebar = function(){
    _renderSidebar();
    updateGamificationUI();
  };

  // loadLesson'u sarmalayarak her ders geçişinde ilerlemeyi kaydediyoruz.
  const _loadLesson = loadLesson;
  loadLesson = function(i, forceCodeReload){
    _loadLesson(i, forceCodeReload);
    persist();
  };

  // Son dersten sonra "Sonraki Ders" butonu loadLesson çağırmadığı için
  // (renderSidebar çağırıyor) burada ayrıca dinliyoruz: kayıt + kutlama.
  document.getElementById('btnNext').addEventListener('click', function(){
    persist();
    if(completedLessons.size === LESSONS.length){
      document.getElementById('celebrateOverlay').classList.add('show');
    }
  });
  document.getElementById('btnCloseCelebrate').addEventListener('click', function(){
    document.getElementById('celebrateOverlay').classList.remove('show');
    goToHome();
  });

  function resetProgress(){
    if(!confirm('Tüm ders ilerlemeniz sıfırlansın mı? Bu işlem geri alınamaz.')) return;
    completedLessons.clear();
    try{ localStorage.removeItem(STORAGE_KEY); }catch(e){}
    loadLesson(0, true);
    renderHome();
  }
  document.getElementById('btnResetProgress').addEventListener('click', resetProgress);
  document.getElementById('btnResetProgress2').addEventListener('click', resetProgress);

  // Sayfa ilk yüklendiğinde kayıtlı ilerlemeyi geri yükle.
  const saved = readSaved();
  if(saved){
    (saved.completed || []).forEach(i=>{ if(i>=0 && i<LESSONS.length) completedLessons.add(i); });
    const startAt = (typeof saved.current === 'number') ? saved.current : 0;
    currentLesson = startAt;
    renderHome();
  } else {
    updateGamificationUI();
  }
})();
</script>
</body>
</html>