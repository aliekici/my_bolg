  code:
`REPORT ztest_ders1.

DATA: lv_isim TYPE string VALUE 'Dunya'.

WRITE: / 'Merhaba,', lv_isim.
WRITE: / 'ABAP dunyasina hos geldiniz!'.
`
},
{
  title:"Değişkenler, Sabitler ve Veri Tipleri",
