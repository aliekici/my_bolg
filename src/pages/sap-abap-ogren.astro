---
// src/pages/sap-abap-ogren.astro
---

<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SAP ABAP Eğitim Bootcamp</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style is:global>
  :root{
    /* ---- SAP editörü değişkenleri (orijinal, dokunulmadı) ---- */
    --tb1:#5a8fd6; --tb2:#2c66a8; --tb3:#123a63;
    --panel:#f3f3f1; --toolbar:#e9e9e6; --border:#b7b7b0;
    --tabactive:#ffffff; --tabinactive:#dedad2;
    --edbg:#ffffff; --gutter:#eef0ee; --gutternum:#8a8f87;
    --kw:#0000ee; --str:#a3144d; --cmt:#1f8b3b; --field:#7a3e9d;
    --statusbar:#d9d7cf;

    /* ---- dış kabuk teması — SAP marka renkleri ---- */
    --bg:#0a121c; --bgpanel:#101d2b; --bgpanel2:#15283a; --bgborder:#213b52;
    --neon:#0a6ed1;      /* SAP Blue — ana vurgu */
    --neonblue:#4fc3f7;  /* Açık SAP mavisi */
    --neonpink:#e9730c;  /* SAP Turuncu — ikincil / uyarı vurgusu */
    --gold:#f0ab00;      /* SAP Altın */
    --sapblue:#0a6ed1;
  }
  *{box-sizing:border-box;}

  /* ==================================================================
     DIŞ KABUK — "ABAP Bootcamp" tasarım dili (SAP renk paleti).
     SAP editörünün kendisi bu bölümde YOKTUR; o, dosyanın altında
     ayrı ve değiştirilmemiş bir blok olarak duruyor (bkz. aşağıdaki not).
     ================================================================== */
  html{ scroll-behavior:smooth; }
  body{
    margin:0; padding:0 0 60px;
    background:
      radial-gradient(circle at 12% 0%, rgba(10,110,209,.16), transparent 40%),
      radial-gradient(circle at 88% 6%, rgba(79,195,247,.10), transparent 42%),
      var(--bg);
    font-family:'Outfit',Arial,sans-serif; color:#dbe1ea; min-height:100vh;
  }
  .pixel{ font-family:'Press Start 2P', monospace; }
  a{ color:inherit; }
  ::-webkit-scrollbar{ width:10px; }
  ::-webkit-scrollbar-track{ background:var(--bg); }
  ::-webkit-scrollbar-thumb{ background:var(--bgborder); border-radius:8px; }

  .pixel-corners{
    clip-path: polygon(0 8px, 8px 8px, 8px 0, calc(100% - 8px) 0, calc(100% - 8px) 8px, 100% 8px,
      100% calc(100% - 8px), calc(100% - 8px) calc(100% - 8px), calc(100% - 8px) 100%,
      8px 100%, 8px calc(100% - 8px), 0 calc(100% - 8px));
  }

  header.topbar{
    position:sticky; top:0; z-index:50; background:rgba(10,18,28,.92); backdrop-filter:blur(6px);
    border-bottom:1px solid var(--bgborder); padding:14px 22px;
    display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
  }
  header.topbar .brand{ display:flex; align-items:center; gap:10px; }
  header.topbar .brand .ico{
    width:32px; height:32px; background:var(--sapblue); color:#fff;
    display:flex; align-items:center; justify-content:center; font-size:16px; flex:0 0 auto;
  }
  header.topbar .brand span{ font-size:10.5px; color:#fff; }
  .backbtn{
    display:flex; align-items:center; gap:7px; background:#0e2338; border:1px solid var(--sapblue);
    color:var(--neonblue); font-size:11px; font-weight:600; padding:9px 16px; cursor:pointer;
    font-family:inherit; border-radius:2px; letter-spacing:.3px;
  }
  .backbtn:hover{ background:#123a5c; color:#fff; }

  /* ---------- Ana sayfa: Ders listesi ---------- */
  #courseHome{ max-width:1180px; margin:0 auto; padding:44px 16px 8px; }
  .home-badge{
    display:inline-block; font-size:9px; letter-spacing:1.2px; color:var(--neonblue);
    border:1px solid rgba(79,195,247,.4); padding:7px 14px; margin-bottom:22px;
    background-image:repeating-linear-gradient(45deg, rgba(10,110,209,.14) 0px, rgba(10,110,209,.14) 2px, transparent 2px, transparent 6px);
  }
  .home-title{ font-size:44px; color:#fff; margin:0 0 16px; letter-spacing:2px; text-shadow:0 0 18px rgba(10,110,209,.6); }
  .home-sub{ max-width:620px; margin:0 0 34px; color:#8b96ab; font-size:13.5px; line-height:1.75; }

  .home-layout{ display:flex; gap:20px; align-items:flex-start; }

  .lessons-panel{ flex:1; min-width:0; background:var(--bgpanel); border:1px solid var(--bgborder); }
  .lessons-panel-head{
    display:flex; align-items:center; gap:9px; background:linear-gradient(90deg,var(--bgpanel),var(--bgpanel2));
    border-bottom:1px solid var(--bgborder); padding:16px 18px; font-size:15px; font-weight:700; color:#fff;
  }
  .lessons-panel-head .ic{ color:var(--neonblue); font-size:16px; }
  .lesson-rows{ display:flex; flex-direction:column; }
  .lesson-row{
    display:flex; align-items:center; gap:14px; padding:15px 18px; border-bottom:1px solid var(--bgborder);
  }
  .lesson-row:last-child{ border-bottom:none; }
  .lesson-row .lr-num{
    flex:0 0 auto; width:24px; height:24px; border-radius:50%; background:var(--bgpanel2); color:var(--neonblue);
    font-size:11px; font-weight:700; display:flex; align-items:center; justify-content:center; border:1px solid var(--bgborder);
  }
  .lesson-row.done .lr-num{ background:var(--neon); color:#fff; border-color:var(--neon); }
  .lesson-row .lr-title{ flex:1; min-width:0; font-size:13.5px; color:#c7cedb; }
  .lesson-row .lr-check{ color:var(--gold); font-size:12px; margin-right:2px; }
  .start-btn{
    flex:0 0 auto; background:var(--sapblue); border:none; color:#fff; font-size:11.5px; font-weight:700;
    padding:8px 18px; border-radius:2px; cursor:pointer; font-family:inherit; letter-spacing:.3px;
  }
  .start-btn:hover{ background:#0959a8; }
  .lesson-row.done .start-btn{ background:var(--bgpanel2); color:var(--neonblue); border:1px solid var(--sapblue); }
  .lesson-row.done .start-btn:hover{ background:#123a5c; }

  .home-sidebar{ width:280px; flex:0 0 280px; display:flex; flex-direction:column; gap:16px; }
  .avatar-card{ background:var(--bgpanel); border:1px solid var(--bgborder); padding:26px 18px; text-align:center; }
  .avatar-badge{
    width:56px; height:56px; margin:0 auto 14px; border-radius:50%; background:linear-gradient(180deg,var(--neon),var(--neonblue));
    display:flex; align-items:center; justify-content:center; font-size:22px; color:#fff;
  }
  .avatar-name{ font-size:13.5px; font-weight:700; color:#fff; margin-bottom:6px; }
  .avatar-level{ font-size:10.5px; letter-spacing:1px; color:var(--gold); font-weight:700; margin-bottom:14px; }
  .reset-link{ background:none; border:none; color:#5c6b85; font-size:10.5px; text-decoration:underline; cursor:pointer; font-family:inherit; }
  .reset-link:hover{ color:var(--neonpink); }

  .progress-card{ background:var(--bgpanel); border:1px solid var(--bgborder); padding:18px; }
  .progress-card-title{ font-size:9.5px; letter-spacing:1.2px; color:var(--neonblue); font-weight:700; margin-bottom:12px; }
  .progress-track{ height:6px; background:#0a0e1a; border:1px solid var(--bgborder); overflow:hidden; margin-bottom:14px; }
  .progress-track i{ display:block; height:100%; width:0%; background:linear-gradient(90deg,var(--sapblue),var(--neonblue)); transition:width .4s ease; }
  .progress-stats{ display:flex; flex-direction:column; gap:9px; }
  .progress-stats div{ display:flex; justify-content:space-between; font-size:11.5px; color:#8b96ab; }
  .progress-stats span:last-child{ color:#dbe1ea; font-weight:600; }

  @media (max-width: 880px){
    .home-layout{ flex-direction:column; }
    .home-sidebar{ width:100%; flex:1 1 auto; }
  }

  /* ---------- Ders görünümü (mevcut yapı) ---------- */
  #lessonView{ display:none; }
  .course{ width:100%; max-width:1180px; margin:32px auto 0; padding:0 16px; display:flex; gap:18px; align-items:flex-start; }

  /* ---------- Sidebar (ders listesi) ---------- */
  .sidebar{ width:280px; flex:0 0 280px; background:var(--bgpanel); border:1px solid var(--bgborder); position:sticky; top:88px; }
  .sidebar-head{ background:linear-gradient(90deg,var(--bgpanel),var(--bgpanel2)); border-bottom:1px solid var(--bgborder); padding:14px 14px 12px; }
  .sidebar-head .sh-eyebrow{ font-size:9px; color:var(--sapblue); letter-spacing:1.2px; margin-bottom:8px; }
  .sidebar-head .sh-progress-row{ display:flex; align-items:center; justify-content:space-between; font-size:10px; color:#8b96ab; margin-bottom:6px; }
  .sidebar-head .sh-bar{ height:6px; background:#0a0e1a; border:1px solid var(--bgborder); overflow:hidden; }
  .sidebar-head .sh-bar i{ display:block; height:100%; width:0%; background:linear-gradient(90deg,var(--sapblue),var(--neonblue)); transition:width .4s ease; }

  .lesson-list{ list-style:none; margin:0; padding:8px; display:flex; flex-direction:column; gap:4px; max-height:520px; overflow-y:auto; }
  .lesson-item{ display:flex; gap:10px; align-items:flex-start; padding:9px 10px; cursor:pointer; border:1px solid transparent; border-radius:2px; }
  .lesson-item:hover{ background:#1b2436; border-color:var(--bgborder); }
  .lesson-item.active{ background:#182236; border-color:rgba(10,110,209,.5); box-shadow:0 0 0 1px rgba(10,110,209,.15) inset; }
  .lesson-num{ flex:0 0 auto; width:22px; height:22px; background:#1b2436; color:#8b96ab; font-size:10px; font-weight:700; display:flex; align-items:center; justify-content:center; border:1px solid var(--bgborder);}
  .lesson-item.active .lesson-num{ background:var(--sapblue); color:#fff; border-color:var(--sapblue); }
  .lesson-item.done .lesson-num{ background:var(--neon); color:#fff; border-color:var(--neon); }
  .lesson-txt{ font-size:12px; color:#c7cedb; line-height:1.4; }
  .lesson-txt .lt{ display:block; font-size:9px; color:#5c6b85; text-transform:uppercase; letter-spacing:.6px; margin-bottom:2px;}
  .sidebar-foot{ padding:11px 14px; border-top:1px solid var(--bgborder); font-size:10px; color:#5c6b85; display:flex; align-items:center; justify-content:space-between; gap:8px;}
  .sidebar-foot button{ background:none; border:1px solid var(--bgborder); color:#8b96ab; font-size:9px; padding:5px 8px; cursor:pointer; font-family:inherit; }
  .sidebar-foot button:hover{ border-color:var(--neonpink); color:var(--neonpink); }

  /* ---------- Main column ---------- */
  .main-col{ flex:1; min-width:0; display:flex; flex-direction:column; gap:16px; }

  .lesson-panel{ background:var(--bgpanel); border:1px solid var(--bgborder); padding:20px 22px; }
  .lesson-panel .lp-eyebrow{ font-size:9px; letter-spacing:1.2px; color:var(--sapblue); font-weight:700; text-transform:uppercase; }
  .lesson-panel h2{ margin:6px 0 12px; font-size:19px; color:#fff; }
  .obj-list{ margin:0 0 14px; padding:0; list-style:none; display:flex; flex-direction:column; gap:6px; }
  .obj-list li{ font-size:12.5px; color:#b7c0d1; padding-left:22px; position:relative; line-height:1.5; }
  .obj-list li::before{ content:'✓'; position:absolute; left:0; top:0; color:var(--neon); font-weight:700; }
  .lp-text p{ font-size:13px; color:#9aa5b8; line-height:1.75; margin:0 0 11px; }
  .lp-text code, .inline-code{ background:var(--bgpanel2); border:1px solid var(--bgborder); border-radius:3px; padding:1px 6px; font:12px/1.4 'Consolas','Courier New',monospace; color:var(--neonblue); }

  .syntax-box{ background:#0a1120; border:1px solid var(--bgborder); border-radius:4px; padding:11px 14px; margin:10px 0 4px; font:12.5px/1.6 'Consolas','Courier New',monospace; color:#d7e6f7; overflow-x:auto; }
  .syntax-box .sx-title{ display:block; font-family:'Outfit',Arial,sans-serif; font-size:9.5px; letter-spacing:1px; text-transform:uppercase; color:var(--gold); margin-bottom:6px; }

  .lesson-nav{ display:flex; justify-content:space-between; align-items:center; gap:10px; margin-top:16px; }
  .navbtn{
    display:flex; align-items:center; gap:6px; background:var(--bgpanel2); border:1px solid var(--bgborder);
    border-radius:2px; padding:8px 14px; font-size:12px; color:#c7cedb; cursor:pointer; font-family:inherit;
    box-shadow:3px 3px 0 0 rgba(0,0,0,.35); transition:transform .08s ease, box-shadow .08s ease;
  }
  .navbtn:hover{ border-color:var(--sapblue); color:#fff; }
  .navbtn:active{ transform:translate(3px,3px); box-shadow:0 0 0 0 transparent; }
  .navbtn:disabled{ opacity:.35; cursor:default; }
  .navbtn.primary{ background:#0c2136; border-color:var(--neon); color:var(--neonblue); }
  .navbtn.primary:hover{ background:#123256; color:#fff; }
  .lesson-progress{ font-size:11px; color:#5c6b85; }

  .disclaimer{ max-width:1180px; margin:26px auto 0; padding:0 16px; text-align:center; font-size:11px; color:#5c6b85; font-style:italic; line-height:1.6; }

  /* ---------- Kutlama katmanı ---------- */
  .celebrate-overlay{ position:fixed; inset:0; background:rgba(5,8,16,.86); display:none; align-items:center; justify-content:center; z-index:200; padding:20px;}
  .celebrate-overlay.show{ display:flex; }
  .celebrate-card{ background:var(--bgpanel); border:1px solid var(--gold); max-width:380px; padding:32px 26px; text-align:center; }
  .celebrate-card .cc-badge{ width:56px;height:56px; margin:0 auto 16px; background:linear-gradient(180deg,var(--gold),#a97b00); display:flex; align-items:center; justify-content:center; font-size:26px; }
  .celebrate-card h3{ color:#fff; font-size:14px; margin:0 0 10px; letter-spacing:.5px; }
  .celebrate-card p{ color:#9aa5b8; font-size:12.5px; line-height:1.65; margin:0 0 18px; }
  .celebrate-card button{ background:var(--sapblue); border:none; color:#fff; padding:10px 22px; font-size:12px; cursor:pointer; font-family:inherit; }
  .celebrate-card button:hover{ background:#0959a8; }

  @media (max-width: 880px){
    .course{ flex-direction:column; }
    .sidebar{ width:100%; flex:1 1 auto; position:static; }
    .lesson-list{ max-height:230px; }
  }

  /* ==================================================================
     SAP ABAP EDİTÖRÜ — GERÇEKÇİ GÖRÜNÜM (BİREBİR KORUNDU)
     Aşağıdaki kurallar orijinal dosyadan DEĞİŞTİRİLMEDEN alınmıştır;
     SE38/SAP GUI hissini bozmamak için dokunulmamıştır.
     ================================================================== */
  /* ---------- SAP window (mevcut simülatör) ---------- */
  .sapwin{
    width:100%;
    border:1px solid #0f2f52; border-radius:3px;
    box-shadow:0 10px 28px rgba(20,30,50,.28), 0 1px 0 #fff inset;
    overflow:hidden; background:var(--panel);
  }
  .titlebar{
    background:linear-gradient(180deg, var(--tb1), var(--tb2) 55%, var(--tb3));
    color:#fff; font-size:12.5px; font-weight:600; padding:6px 10px;
    display:flex; align-items:center; justify-content:space-between;
    text-shadow:0 1px 1px rgba(0,0,0,.35);
  }
  .titlebar .dots{ display:flex; gap:6px; }
  .titlebar .dots span{ width:9px; height:9px; border-radius:50%; background:rgba(255,255,255,.35); display:inline-block; }

  .menubar{
    background:var(--panel); border-bottom:1px solid var(--border);
    display:flex; gap:14px; padding:4px 10px; font-size:11.5px; color:#333;
  }
  .menubar span{ cursor:default; padding:2px 4px; border-radius:2px; }
  .menubar span:hover{ background:#cfe0f5; }

  .toolbar{
    background:var(--toolbar); border-bottom:1px solid var(--border);
    display:flex; align-items:center; gap:6px; padding:6px 8px; flex-wrap:wrap;
  }
  .okcode{
    display:flex; align-items:center; gap:6px; background:#fff;
    border:1px solid #9aa3ad; border-radius:2px; padding:2px 6px; margin-right:10px;
  }
  .okcode svg{ width:12px; height:12px; }
  .okcode input{
    border:none; outline:none; font-size:12px; font-family:inherit; width:150px; color:#222;
  }
  .tbtn{
    display:flex; align-items:center; gap:5px; background:#f6f6f4; border:1px solid #c7c7c0;
    border-radius:3px; padding:4px 9px; font-size:11.5px; color:#28313a; cursor:pointer;
  }
  .tbtn:hover{ background:#dfeaf7; border-color:#7fa8d6; }
  .tbtn:active{ background:#c9def2; }
  .tbtn svg{ width:14px; height:14px; }
  .tbtn.primary{ background:#eef7ea; border-color:#8fc47a; }
  .tbtn.primary:hover{ background:#dcefd3; }
  .sep{ width:1px; align-self:stretch; background:var(--border); margin:0 4px; }

  .tabstrip{ display:flex; background:var(--panel); border-bottom:1px solid var(--border); padding:0 8px; }
  .tab{ padding:6px 16px; font-size:11.5px; color:#7c7c74; border:1px solid transparent; border-bottom:none; cursor:default; }
  .tab.active{ background:var(--tabactive); color:#1c1c1c; border-color:var(--border); border-radius:3px 3px 0 0; margin-bottom:-1px; border-bottom:1px solid var(--tabactive); }

  .screen{ background:var(--edbg); min-height:340px; display:none; }
  .screen.show{ display:block; }

  .editor-area{ display:flex; }
  .gutter{
    background:var(--gutter); color:var(--gutternum); font:12.5px/1.55 'Consolas','Courier New',monospace;
    text-align:right; padding:10px 8px 10px 4px; user-select:none; min-width:34px;
    white-space:pre;
  }
  .editor-wrap{ position:relative; flex:1; overflow:hidden; }
  .editor-wrap pre, .editor-wrap textarea{
    margin:0; padding:10px 12px; font:12.5px/1.55 'Consolas','Courier New',monospace;
    white-space:pre; overflow:auto; height:340px; width:100%;
    border:none; box-sizing:border-box;
  }
  .hl-layer{ position:absolute; top:0; left:0; pointer-events:none; color:#1b1b1b; background:transparent; }
  .code-input{ position:relative; z-index:1; background:transparent; color:transparent; caret-color:#111; resize:none; outline:none; }
  .kw{ color:var(--kw); font-weight:700; }
  .str{ color:var(--str); }
  .cmt{ color:var(--cmt); font-style:italic; }

  .output-toolbar{ display:flex; align-items:center; gap:8px; padding:6px 10px; background:#fafaf8; border-bottom:1px solid var(--border); }
  .output-toolbar .rname{ font-size:11px; color:#666; }
  .listhead{ padding:10px 14px 4px; font:12px/1.5 'Consolas','Courier New',monospace; color:#444; border-bottom:1px solid #ddd; }
  .listbody{ padding:10px 14px; font:13px/1.65 'Consolas','Courier New',monospace; color:#111; min-height:260px; white-space:pre-wrap; }
  .listbody .err{ color:#b3261e; }

  .statusbar{
    background:var(--statusbar); border-top:1px solid var(--border);
    display:flex; font-size:10.5px; color:#3a3f36;
  }
  .statusbar div{ padding:4px 10px; border-right:1px solid #c3c1b8; }
  .statusbar div:last-child{ border-right:none; margin-left:auto; }
  .dot{ width:6px; height:6px; border-radius:50%; background:#e0a400; display:inline-block; margin-right:5px; }
</style>
</head>
<body>

  <header class="topbar">
    <div class="brand">
      <div class="ico">▣</div>
      <span class="pixel">SAP ABAP EĞİTİM SİMÜLATÖRÜ</span>
    </div>
    <button class="backbtn" id="btnHeaderBack">← Geri Dön</button>
  </header>

  <!-- ================= ANA SAYFA: DERS LİSTESİ ================= -->
  <div id="courseHome">
    <span class="home-badge">💾 İLERLEME TARAYICIDA SAKLANIYOR</span>
    <h1 class="home-title pixel">ABAP</h1>
    <p class="home-sub">İlerlemen artık tarayıcında saklanıyor. İstediğin zaman çıkıp geri dönebilirsin! Soldaki listeden bir ders seçip başlayın; örnek kodu F8 ile çalıştırarak çıktıyı görün.</p>

    <div class="home-layout">
      <div class="lessons-panel">
        <div class="lessons-panel-head"><span class="ic">🗄️</span> 1. Dersler</div>
        <div class="lesson-rows" id="lessonRows"></div>
      </div>

      <div class="home-sidebar">
        <div class="avatar-card">
          <div class="avatar-badge" id="avatarBadge">:)</div>
          <div class="avatar-name">Yerel Öğrenci</div>
          <div class="avatar-level" id="avatarLevel">SEVİYE 1</div>
          <button class="reset-link" id="btnResetProgress2">İlerlemeyi Sıfırla</button>
        </div>
        <div class="progress-card">
          <div class="progress-card-title">DERS İLERLEMESİ</div>
          <div class="progress-track"><i id="homeProgressFill"></i></div>
          <div class="progress-stats">
            <div><span>Dersler</span><span id="statLessons">0 / 9</span></div>
            <div><span>Kazanılan XP</span><span id="statXP">0 / 225</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="disclaimer">
      Bu araç SAP ABAP öğrenimini kolaylaştırmak için hazırlanmış bir <strong>simülasyon arayüzüdür</strong>; gerçek bir SAP sistemine bağlı değildir ve SAP SE ile ilişkili ya da onaylı değildir. "SAP" adı yalnızca referans amacıyla anılmaktadır.
    </div>
  </div>

  <!-- ================= DERS GÖRÜNÜMÜ ================= -->
  <div id="lessonView">
  <div class="course">

    <!-- ---------- SIDEBAR ---------- -->
    <div class="sidebar">
      <div class="sidebar-head">
        <div class="sh-eyebrow pixel">DERS PLANI</div>
        <div class="sh-progress-row">
          <span id="sidebarProgress">Ders 1 / 9</span>
