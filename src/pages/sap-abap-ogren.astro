  ],
  syntax:[
    "LOOP AT it_musteri INTO wa_musteri.\n  IF wa_musteri-ort01 = 'Istanbul'.\n    WRITE: / sy-tabix, wa_musteri-name1.\n  ENDIF.\nENDLOOP."
  ],
  code:
`REPORT zders8_filtre.

DATA: it_musteri TYPE TABLE OF kna1,
      wa_musteri TYPE kna1,
      lv_sayac   TYPE i VALUE 0.

SELECT kunnr name1 ort01 land1 FROM kna1 INTO TABLE it_musteri.

WRITE: / 'Istanbuldaki Musteriler:'.
WRITE: / '-----------------------------------'.

LOOP AT it_musteri INTO wa_musteri.
  IF wa_musteri-ort01 = 'Istanbul'.
    lv_sayac = lv_sayac + 1.
    WRITE: / sy-tabix, wa_musteri-name1, wa_musteri-ort01.
  ENDIF.
ENDLOOP.

WRITE: / '-----------------------------------'.
